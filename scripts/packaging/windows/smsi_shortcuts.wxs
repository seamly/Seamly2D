<?xml version="1.0" encoding="UTF-8"?>
<!--
 **  @file   smsi_shortcuts.wxs
 **  @author slspencer
 **  @date   2026-08-15
 **
 **  @brief  The optional desktop shortcuts and the install-info
 **          registry values the apps read on first run.
 **
 **  Split out of smsi.wxs. Linked by the two ComponentGroupRefs in that file. A WiX fragment
 **  nothing refers to is dropped WITHOUT AN ERROR, so the MSI would still
 **  build and would simply be missing all of this.
 **
 **  @copyright
 **  This source code is part of the Seamly project, a suite of apparel CAD
 **  software.
 **  Copyright (C) 2026 Seamly2D Project
 **  All Rights Reserved.
 **
 **  SeamlyLayout is licensed under the MIT license.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Fragment>

    <ComponentGroup Id="InstallInfo" Directory="INSTALLFOLDER">

      <!-- Install breadcrumbs: read by upgrades and by the Task 14 installer
           prompts; removed on uninstall automatically (component rules). -->
      <Component Id="InstallInfoRegistry">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Seamly\Seamly2D">
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
          <RegistryValue Name="DisplayVersion" Type="string" Value="$(var.DisplayVersion)" />
          <!-- InstWinX64.1.2: the data root the user chose. Every app reads it
               on first run and adopts it, so the value must name a folder
               somebody chose. SEAMLYDATAROOTRECORDED is what guarantees that -
               see the long note beside it in smsi.wxs. Do NOT put
               [SEAMLYDATAROOT] here: a directory id always resolves, so a
               silent install with no arguments would record C:\SeamlyData.

               Written even when the user declined the copy - recording the
               folder and filling it are separate decisions. Empty when nothing
               chose a root, which the apps read as "use your own default". -->
          <RegistryValue Name="DataRoot" Type="string" Value="[SEAMLYDATAROOTRECORDED]" />
          <!-- Same guard as DataRoot above, and for the same reason: raw
               [SEAMLYDATAPARENT] is a directory id, so it always resolves by
               the time this runs (sequence 5000, after CostFinalize), even on
               a run that chose nothing. SEAMLYDATAPARENTRECORDED is empty
               unless SEAMLYDATACHOSEN - see smsi.wxs. -->
          <RegistryValue Name="DataParent" Type="string" Value="[SEAMLYDATAPARENTRECORDED]" />
        </RegistryKey>
      </Component>

    </ComponentGroup>

    <!-- ================= optional desktop shortcuts ======================= -->
    <!-- Installed only when SEAMLYDESKTOPSHORTCUTS is set - by the checkbox on
         SeamlyShortcutsDlg, by its default of 1, or on the command line. The
         property is public and secure, so the value the user chose in the
         client-side UI reaches the elevated server-side sequence, where
         CostFinalize evaluates these component conditions.

         Per-machine install, so these land on the All Users desktop and each
         component needs a KeyPath of its own; a non-advertised shortcut cannot
         be one, so an HKLM breadcrumb beside the install-info key serves. That
         is what raises ICE43 ("should use a registry key under HKCU as its
         KeyPath") during validation - expected here and documented in
         scripts\packaging\windows\README.md, since HKCU is exactly wrong for a
         per-machine package.

         The shortcuts are non-advertised (a plain Target) rather than
         advertised like the Start Menu ones: an advertised shortcut has to sit
         in the component that holds its target file, which would tie it to the
         executable's component and make it impossible to condition
         separately. -->

    <StandardDirectory Id="DesktopFolder" />
    <ComponentGroup Id="OptionalDesktopShortcuts" Directory="INSTALLFOLDER">
      <Component Id="Seamly2DDesktopShortcutComponent" Condition="SEAMLYDESKTOPSHORTCUTS">
        <Shortcut Id="Seamly2DDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="Seamly2D"
                  Description="Seamly2D pattern drafting"
                  Target="[INSTALLFOLDER]seamly2d.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="seamly2d.ico" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Seamly\Seamly2D"
                       Name="DesktopShortcutSeamly2D"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="SeamlyMeDesktopShortcutComponent" Condition="SEAMLYDESKTOPSHORTCUTS">
        <Shortcut Id="SeamlyMeDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="SeamlyMe"
                  Description="SeamlyMe measurements"
                  Target="[INSTALLFOLDER]seamlyme.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="seamlyme.ico" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Seamly\Seamly2D"
                       Name="DesktopShortcutSeamlyMe"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- SeamlyLayout gets one too. It opens standalone with no argument, so a
           bare desktop launch is a supported way to start it - see the comment
           on SeamlyShortcutsDlg above. The checkbox has always named all three
           apps; only the component was missing. -->
      <Component Id="SeamlyLayoutDesktopShortcutComponent" Condition="SEAMLYDESKTOPSHORTCUTS">
        <Shortcut Id="SeamlyLayoutDesktopShortcut"
                  Directory="DesktopFolder"
                  Name="SeamlyLayout"
                  Description="SeamlyLayout pattern pieces layout"
                  Target="[INSTALLFOLDER]SeamlyLayout.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="seamlylayout.ico" />
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Seamly\Seamly2D"
                       Name="DesktopShortcutSeamlyLayout"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ============ per-user settings cleanup on uninstall ================ -->
    <!-- Each app's AppConfigLocation settings (%LOCALAPPDATA%\Seamly\<App>\)
         and the shared common settings (%APPDATA%\Seamly\) are per-user, so a
         perMachine uninstall cannot reach every user's profile - only the one
         it runs as. See the same limitation already documented for
         SEAMLYLEGACYSTARTMENU in smsi_legacy.wxs.

         The user-data root (patterns, measurements) is deliberately NOT
         touched here - that is CreateUserDataRoot's Permanent="yes" component
         in smsi_files.wxs, and stays untouched on purpose.

         NOT UPGRADINGPRODUCTCODE matters: RemoveExistingProducts also
         "uninstalls" the old product's ProductCode partway through a major
         upgrade, and Windows Installer sets UPGRADINGPRODUCTCODE for exactly
         that case. Without the guard, every version bump would wipe the
         settings the new version is about to read forward on its own first
         run. A genuine standalone uninstall (Programs & Features, or
         msiexec /x with no newer package mid-install) leaves it unset.

         Properties, not directory ids: RemoveFolderEx resolves at sequence
         799, before CostFinalize resolves the Directory table, so a directory
         id would read empty there - the same trap documented at length in
         smsi.wxs for SEAMLYDATAROOT/SEAMLYDATAPARENT. [%LOCALAPPDATA] and
         [%APPDATA] are environment properties instead, set at session start,
         and resolve to the user this immediate action runs as - the
         installing user in the normal interactive-elevation case. -->
    <SetProperty Id="SEAMLYLOCALAPPDATA"
                 Value="[%LOCALAPPDATA]\Seamly"
                 After="AppSearch" Sequence="both" />
    <SetProperty Id="SEAMLYROAMINGAPPDATA"
                 Value="[%APPDATA]\Seamly"
                 After="AppSearch" Sequence="both" />

    <ComponentGroup Id="PerUserSettingsRemoval" Directory="INSTALLFOLDER">
      <Component Id="RemoveLocalAppDataSettings" Guid="15BCCEA7-CD8F-4A58-9F46-86125519AC35"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKCU" Key="Software\Seamly\Seamly2D" Name="RemovedLocalAppData"
                       Type="string" Value="[SEAMLYLOCALAPPDATA]" KeyPath="yes" />
        <util:RemoveFolderEx Property="SEAMLYLOCALAPPDATA" On="uninstall" />
      </Component>
      <Component Id="RemoveRoamingAppDataSettings" Guid="7381D399-B7CE-47F9-9423-460ED69209E7"
                 Condition="NOT UPGRADINGPRODUCTCODE">
        <RegistryValue Root="HKCU" Key="Software\Seamly\Seamly2D" Name="RemovedRoamingAppData"
                       Type="string" Value="[SEAMLYROAMINGAPPDATA]" KeyPath="yes" />
        <util:RemoveFolderEx Property="SEAMLYROAMINGAPPDATA" On="uninstall" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
