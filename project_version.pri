#-------------------------------------------------
#
# @file   project_version.pri
# @author slspencer
# Copyright (C) 2026 Seamly2D Project
# SPDX-License-Identifier: GPL-3.0-or-later
#
# @brief
# Creates the build version header when it is missing and sets PROJECT_VERSION from it.
#
# - Git ignores the header, so a build does not change tracked files.
# - packaging/version.sh writes the header. A build without version.sh (Qt Creator, the CI test job) gets 0.0.0.
# - PROJECT_VERSION gives the macOS app projects their VERSION, which fills in the Info.plist version.
# - Seamly.pro includes this file so the header exists before make -j starts the subproject qmake runs.
#   Parallel qmake runs that write and read a missing header at the same time read an empty file.
#
#-------------------------------------------------

project_version_header = $$PWD/src/libs/vmisc/project_version_number.h
!exists($$project_version_header) {
    # Keep this layout in step with packaging/version.sh.
    project_version_default = \
        "// Generated by project_version.pri. packaging/version.sh replaces it. Git ignores this file." \
        "$${LITERAL_HASH}ifndef PROJECT_VERSION_NUMBER_H" \
        "$${LITERAL_HASH}define PROJECT_VERSION_NUMBER_H" \
        "$${LITERAL_HASH}define PROJECT_VERSION_MAJOR 0" \
        "$${LITERAL_HASH}define PROJECT_VERSION_MINOR 0" \
        "$${LITERAL_HASH}define PROJECT_VERSION_DAY_HOUR 0" \
        "$${LITERAL_HASH}define PROJECT_VERSION_STR \"0.0.0\"" \
        "$${LITERAL_HASH}endif // PROJECT_VERSION_NUMBER_H"
    write_file($$project_version_header, project_version_default)|error("Cannot write $${project_version_header}")
}
project_version_lines = $$cat($$project_version_header, lines)
project_version_line = $$find(project_version_lines, "PROJECT_VERSION_STR")
PROJECT_VERSION = $$replace(project_version_line, "^.*\"(.*)\".*$", "\\1")
# Braces: qmake reads a dot after a variable name as part of the name.
!contains(PROJECT_VERSION, "^[0-9]+\\.[0-9]+\\.[0-9]+$") {
    error("No PROJECT_VERSION_STR \"X.Y.Z\" in $${project_version_header}. Run packaging/version.sh or delete the file.")
}
