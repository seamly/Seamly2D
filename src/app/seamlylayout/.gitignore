/qt_frontend/CMakeFiles/
/qt_frontend/CMakeCache.txt
/qt_frontend/.cmake/
/qt_frontend/.qt/
/qt_frontend/.qtc_clangd/
/qt_frontend/*.user
/qt_frontend/*.user.*
/.vs/
/.vscode/
*.dxf
*.txt