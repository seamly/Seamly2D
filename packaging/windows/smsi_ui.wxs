<?xml version="1.0" encoding="UTF-8"?>
<!--
 **  @file   smsi_ui.wxs
 **  @author slspencer
 **  @date   2026-08-15
 **
 **  @brief  The Seamly installer wizard: its dialogs and every transition
 **          between them.
 **
 **  Split out of smsi.wxs, which keeps <Package> and everything the linker
 **  needs to see there. This fragment is pulled in by the <UIRef Id="SeamlyUI">
 **  in that file. WITHOUT THAT REFERENCE THE FRAGMENT IS DROPPED SILENTLY -
 **  the MSI still builds, and the wizard is simply wrong. smsi_check_authoring.ps1
 **  asserts every page and arrow, so run it after any change here.
 **
 **  @copyright
 **  This source code is part of the Seamly project, a suite of apparel CAD
 **  software.
 **  Copyright (C) 2026 Seamly2D Project
 **  All Rights Reserved.
 **
 **  SeamlyLayout is licensed under the MIT license.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Fragment>
    <!-- The license page shows license.rtf, which sits beside this .wxs;
         $(sys.SOURCEFILEDIR) is the folder of this source file (with a trailing
         backslash), so the reference survives relocating the tree. It resolves
         against THIS file now, and both live in the same directory. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)license.rtf" />

    <!-- Seamly logo replaces the stock WiX banner and dialog bitmaps.
         packaging\assets\generate_wix_images.ps1 built both files from
         src\libs\vmisc\share\resources\icon\logos\seamly_logo_192.png.
         The banner keeps its left ~350px clear for our Title/Description
         text (X=15/25 in every custom dialog); the dialog bitmap keeps its
         left 180px clear of the stock WelcomeDlg/ExitDialog text, which
         starts at dialog-unit X=135. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.RepoRoot)\packaging\assets\wix_banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.RepoRoot)\packaging\assets\wix_dialog.bmp" />

    <!-- WixUI_Common carries the shared bitmaps and icons the stock dialogs
         draw with (WixUI_Bmp_Banner, WixUI_Bmp_Dialog, WixUI_Ico_Info, ...).
         It defines no page order, so the chain below is entirely ours. Each
         stock dialog is its own fragment, pulled in by DialogRef. -->
    <UIRef Id="WixUI_Common" />

    <!-- ================= wizard dialog set ============= -->
    <!--
      This installer uses a custom wizard flow instead of WixUI_InstallDir.
      We reuse the stock WiX dialogs by DialogRef and replace the ownable
      pages (PrepareDlg and MaintenanceTypeDlg) with Seamly versions.

      Fresh install flow: PrepareDlg -> WelcomeDlg -> LicenseAgreementDlg ->
      [PreviousInstallDlg] -> [DataLocationDlg] -> ShortcutsDlg ->
      VerifyReadyDlg -> ProgressDlg -> ExitDialog. PreviousInstallDlg appears
      only when an earlier program install is found; DataLocationDlg appears
      only when an earlier install already recorded a data root
      (SEAMLYDATAROOTRECORDED) - a data root is otherwise fixed and created
      silently, with no page asking about it at all.

      Maintenance flow: MaintenanceWelcomeDlg -> SeamlyMaintenanceTypeDlg ->
      VerifyReadyDlg. Back and Cancel follow the stock wizard behavior.

      The custom pages match the stock dialog styling and use the same banner
      and dialog bitmaps so they look like the rest of the installer.
    -->
    <!-- One source for the condition that decides whether the previous-install
         page appears. It is needed several times - the License Next rows, the
         SeamlyDataLocationDlg Back rows, and the SeamlyShortcutsDlg Back row -
         and they must not drift apart, because a gap or an overlap between
         them strands the wizard on a page with no working button. -->
    <?define PreviousInstallFound = "((SEAMLYOLDS2DEXE AND SEAMLYOLDMEEXE AND NOT SEAMLYOLDLAYOUTEXE) OR SEAMLYNEWLAYOUTEXE) AND NOT Installed" ?>

    <!-- The Id is what smsi.wxs's UIRef names. An unnamed <UI> in a fragment
         has nothing to reference and would never link. -->
    <UI Id="SeamlyUI">

      <!-- The stock sets define these three styles themselves; WixUI_Common
           does not. Same face, sizes and bold bit as WixUI_InstallDir used. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <!-- Carried over from WixUI_InstallDir: the package has one feature, so
           Apps and features offers Repair and Uninstall but no Change. -->
      <Property Id="ARPNOMODIFY" Value="1" />

      <!-- Keep this order as-is: the linker assigns the sequence numbers in the
           order these four dialogs are referenced, and the first matching one is
           shown first. This is the stock order and must stay:

             ResumeDlg              1296  Installed AND (RESUME OR Preselected)
             WelcomeDlg             1297  NOT Installed OR PATCH
             MaintenanceWelcomeDlg  1298  Installed, not resuming, not a patch
             ProgressDlg            1299

           Changing the order would make the wrong page appear during resume. -->
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="WelcomeDlg" />
      <DialogRef Id="MaintenanceWelcomeDlg" />
      <DialogRef Id="ProgressDlg" />

      <!-- Order below is irrelevant: these are reached by a button, not by a
           sequence number. -->
      <DialogRef Id="LicenseAgreementDlg" />
      <DialogRef Id="VerifyReadyDlg" />
      <DialogRef Id="CancelDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <!-- No DialogRef Id="PrepareDlg": SeamlyPrepareDlg below replaces it. -->
      <DialogRef Id="OutOfDiskDlg" />
      <DialogRef Id="OutOfRbDiskDlg" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="ExitDialog" />

      <!-- ========== preparing (replaces stock PrepareDlg) ================= -->
      <!-- Same geometry and bitmap as stock WelcomeDlg/PrepareDlg (the big
           left-side WixUIDialogBmp, not the banner strip the five pages below
           use) so this looks like the same wizard opening, not a new style.
           See the REPLACED-not-reused note above for why this page exists and
           how Continue hands off to AppSearch/WelcomeDlg. -->
      <Dialog Id="SeamlyPrepareDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234"
                 TabSkip="no" Disabled="yes" Text="WixUI_Bmp_Dialog" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0"
                 Disabled="yes" TabSkip="yes" />

        <!-- Deliberately NOT "Welcome to the [ProductName] Setup Wizard" - that
             is WelcomeDlg's own title, one click later. Both dialogs really do
             work (this one blocks on Modal="yes" by default, Continue and
             Cancel both fire), but sharing WelcomeDlg's exact wording reads as
             one Welcome page flashing by broken, not two working pages in a
             row - that is what the 2026-09-18 laptop test actually saw. -->
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="60"
                 Transparent="yes" NoPrefix="yes" TabSkip="yes"
                 Text="{\WixUI_Font_Bigger}Preparing to install [ProductName]" />
        <Control Id="Description" Type="Text" X="135" Y="80" Width="220" Height="60"
                 Transparent="yes" NoPrefix="yes" TabSkip="yes"
                 Text="Click Continue to let Setup get ready to install [ProductName]. Click Cancel to exit without installing." />

        <!-- Disabled placeholder, matching stock WelcomeDlg: keeps the button
             row aligned with every later page without offering a route
             backward from the first page. -->
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Disabled="yes" TabSkip="no" Text="&amp;Back" />
        <Control Id="Continue" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" TabSkip="no" Text="&amp;Continue">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" TabSkip="no" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ========== "an existing installation was found" ================= -->
      <!-- No NoMinimize: the stock WixUI dialogs allow minimizing (Attributes
           7), and these two have to feel like pages of the same wizard. -->
      <Dialog Id="SeamlyPreviousInstallDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}An existing installation was found" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Please read this before Setup replaces any program files." />

        <!-- Shown only for an older MSI of this same product. -->
        <Control Id="UpgradeText" Type="Text" X="20" Y="58" Width="330" Height="32"
                 NoPrefix="yes"
                 ShowCondition="WIX_UPGRADE_DETECTED"
                 HideCondition="NOT WIX_UPGRADE_DETECTED"
                 Text="An earlier version of Seamly apps installed by this installer was found. It holds Seamly2D, SeamlyLayout, and SeamlyMe. Setup will remove these program files and install this version in its place." />

        <!-- Shown only for the old NSIS installation, which is a separate
             product this installer must not and cannot remove. -->
        <Control Id="LegacyInstallText" Type="Text" X="20" Y="94" Width="330" Height="50"
                 NoPrefix="yes"
                 ShowCondition="SEAMLYLEGACYUNINSTALLSTRING"
                 HideCondition="NOT SEAMLYLEGACYUNINSTALLSTRING"
                 Text="An older Seamly2D from the previous installer was found in [SEAMLYLEGACYINSTALLDIR]. It holds Seamly2D and SeamlyMe, and this version replaces both, so Setup will remove its program directory, Start Menu shortcuts and entry in Apps and features. Nothing else in that folder is kept, so move anything of your own out of it before continuing." />

        <!-- Always shown: the point of the whole dialog. -->
        <Control Id="UserDataText" Type="Text" X="20" Y="150" Width="330" Height="76"
                 NoPrefix="yes"
                 Text="Your own work is not touched. Patterns, measurements and templates stay in your user data folder - if Setup already knows that folder, it shows it on the next page; Setup never deletes or overwrites what is already there. Your settings stay in AppData\Local\Seamly and AppData\Roaming\Seamly. Neither installing nor uninstalling Seamly removes any of them." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="&amp;Back">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="SeamlyDataLocationDlg" Order="1"
                   Condition="SEAMLYDATAROOTRECORDED" />
          <Publish Event="NewDialog" Value="SeamlyShortcutsDlg" Order="2"
                   Condition="NOT SEAMLYDATAROOTRECORDED" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ========== optional desktop shortcuts =========================== -->
      <!-- ONE checkbox for all three apps, not one per app: it is a choice a
           user makes once. SeamlyLayout gets a desktop shortcut like the other
           two, because it opens without any input (a standalone launch) as well
           as from seamly2d's Layout Mode handoff. -->
      <Dialog Id="SeamlyShortcutsDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Shortcuts" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Choose where Setup puts the shortcuts." />

        <Control Id="Explain" Type="Text" X="20" Y="60" Width="330" Height="24"
                 NoPrefix="yes"
                 Text="Start Menu shortcuts are always created. Desktop shortcuts are optional." />
        <Control Id="DesktopShortcutsCheckBox" Type="CheckBox" X="20" Y="94" Width="330" Height="18"
                 Property="SEAMLYDESKTOPSHORTCUTS" CheckBoxValue="1"
                 Text="Create &amp;desktop shortcuts for Seamly2D, SeamlyLayout, and SeamlyMe" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="&amp;Back">
          <Publish Event="NewDialog" Value="SeamlyDataLocationDlg" Order="1"
                   Condition="SEAMLYDATAROOTRECORDED" />
          <Publish Event="NewDialog" Value="SeamlyPreviousInstallDlg" Order="2"
                   Condition="NOT SEAMLYDATAROOTRECORDED AND $(var.PreviousInstallFound)" />
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" Order="3"
                   Condition="NOT SEAMLYDATAROOTRECORDED AND NOT ($(var.PreviousInstallFound))" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Next">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ========== user-data directory (read-only) ======== -->
      <!-- Shown only when an earlier install already recorded a data root
           (SEAMLYDATAROOTRECORDED, smsi.wxs) - an update or a repair reached
           through the wizard. The location is fixed and cannot be edited:
           Setup never relocates existing data (B2 in TODO_INSTALLER.md). A
           fresh install skips this page entirely, since there is nothing yet
           to confirm - the fixed default is created silently. -->
      <Dialog Id="SeamlyDataLocationDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Your data location" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="Setup found where your patterns and measurements are kept." />

        <Control Id="Explain" Type="Text" X="20" Y="60" Width="330" Height="48"
                 NoPrefix="yes"
                 Text="Your existing patterns and measurements stay exactly where they are. Setup only adds anything missing there - it never moves, copies or deletes your work." />

        <Control Id="FolderLabel" Type="Text" X="20" Y="118" Width="330" Height="10"
                 NoPrefix="yes" Text="Your work is kept in:" />
        <Control Id="Folder" Type="Text" X="20" Y="130" Width="330" Height="12"
                 NoPrefix="yes" Text="[SEAMLYDATAROOT]" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="&amp;Back">
          <Publish Event="NewDialog" Value="SeamlyPreviousInstallDlg" Order="1"
                   Condition="$(var.PreviousInstallFound)" />
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" Order="2"
                   Condition="NOT ($(var.PreviousInstallFound))" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="&amp;Continue">
          <Publish Event="NewDialog" Value="SeamlyShortcutsDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ========== change, repair or remove ============================== -->
      <!-- Replacement for the stock MaintenanceTypeDlg. WiX cannot extend a
           stock dialog defined elsewhere, so this dialog is copied and kept in
           sync with the original behavior.

           This page appears only when this build's ProductCode is already
           installed. smsi.ps1 creates a new ProductCode for each build, so a
           re-run can look like a duplicate install. The version note helps the
           user see which version is installed and whether this installer matches
           it.

           SEAMLYINSTALLEDVERSION comes from AppSearch reading the last install's
           DisplayVersion. The same Disable/Show conditions and WixUI_InstallMode
           values are kept so Repair and Remove still behave like the stock dialog. -->
      <Dialog Id="SeamlyMaintenanceTypeDlg" Width="370" Height="270"
              Title="[ProductName] Setup">

        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15"
                 Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Change, repair, or remove installation" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="Select the operation you wish to perform." />

        <!-- Change is disabled by ARPNOMODIFY: the package has one feature. -->
        <Control Id="ChangeButton" Type="PushButton" X="40" Y="65" Width="80" Height="17"
                 Default="yes" Text="&amp;Change"
                 DisableCondition="ARPNOMODIFY OR BURNMSIREPAIR OR BURNMSIUNINSTALL">
          <Publish Property="WixUI_InstallMode" Value="Change" />
        </Control>
        <Control Id="ChangeText" Type="Text" X="60" Y="85" Width="280" Height="20"
                 HideCondition="ARPNOMODIFY OR BURNMSIREPAIR OR BURNMSIUNINSTALL"
                 Text="Lets you change the way features are installed." />
        <Control Id="ChangeDisabledText" Type="Text" X="60" Y="85" Width="280" Height="20"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="ARPNOMODIFY OR BURNMSIREPAIR OR BURNMSIUNINSTALL"
                 Text="[ProductName] has no independently selectable features." />

        <Control Id="RepairButton" Type="PushButton" X="40" Y="118" Width="80" Height="17"
                 Text="Re&amp;pair"
                 DisableCondition="ARPNOREPAIR OR BURNMSIMODIFY OR BURNMSIUNINSTALL">
          <Publish Property="WixUI_InstallMode" Value="Repair" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="RepairText" Type="Text" X="60" Y="138" Width="280" Height="30"
                 HideCondition="ARPNOREPAIR OR BURNMSIMODIFY OR BURNMSIUNINSTALL"
                 Text="Repairs errors in the most recent installation by fixing missing and corrupt files, shortcuts, and registry entries." />
        <Control Id="RepairDisabledText" Type="Text" X="60" Y="138" Width="280" Height="30"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="ARPNOREPAIR OR BURNMSIMODIFY OR BURNMSIUNINSTALL"
                 Text="[ProductName] cannot be repaired." />

        <Control Id="RemoveButton" Type="PushButton" X="40" Y="171" Width="80" Height="17"
                 Text="&amp;Remove"
                 DisableCondition="ARPNOREMOVE OR BURNMSIREPAIR OR BURNMSIMODIFY">
          <Publish Property="WixUI_InstallMode" Value="Remove" Order="1" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
        </Control>
        <Control Id="RemoveText" Type="Text" X="60" Y="191" Width="280" Height="20"
                 NoPrefix="yes"
                 HideCondition="ARPNOREMOVE OR BURNMSIREPAIR OR BURNMSIMODIFY"
                 Text="Removes [ProductName] from your computer." />
        <Control Id="RemoveDisabledText" Type="Text" X="60" Y="191" Width="280" Height="20"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="ARPNOREMOVE OR BURNMSIREPAIR OR BURNMSIMODIFY"
                 Text="[ProductName] cannot be removed." />

        <!-- The three version lines share one slot, between RemoveText and
             BottomLine. Their conditions are disjoint, so exactly one shows. -->
        <Control Id="SameVersionText" Type="Text" X="25" Y="214" Width="320" Height="18"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="SEAMLYINSTALLEDVERSION = &quot;$(var.DisplayVersion)&quot;"
                 Text="Seamly $(var.DisplayVersion) is installed. This installer holds that same version." />
        <Control Id="OtherVersionText" Type="Text" X="25" Y="214" Width="320" Height="18"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="SEAMLYINSTALLEDVERSION AND SEAMLYINSTALLEDVERSION &lt;&gt; &quot;$(var.DisplayVersion)&quot;"
                 Text="Seamly [SEAMLYINSTALLEDVERSION] is installed. This installer holds $(var.DisplayVersion)." />
        <Control Id="UnknownVersionText" Type="Text" X="25" Y="214" Width="320" Height="18"
                 Hidden="yes" NoPrefix="yes"
                 ShowCondition="NOT SEAMLYINSTALLEDVERSION"
                 Text="This installer holds Seamly $(var.DisplayVersion)." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="&amp;Back">
          <Publish Event="NewDialog" Value="MaintenanceWelcomeDlg" />
        </Control>
        <!-- Visible but permanently disabled, exactly as the stock page has it:
             the three buttons above are the choice, and Next has nothing to do.
             Removing it would move Back and Cancel and break the alignment
             every other page in the wizard shares. -->
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Disabled="yes" Text="&amp;Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- ========== the chain ============================================ -->
      <!-- Every row here is a page transition. Stock dialogs already handle
           their own buttons; this block defines the wizard order, so nothing
           else competes with it. -->

      <!-- Welcome. The patch route is the stock one: a patch has nothing to
           choose, so it goes straight to the ready page. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog"
               Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <!-- License. LicenseAgreementDlg disables its own Next until the radio
           button is accepted, so the LicenseAccepted test only repeats what the
           control condition already enforces - the stock sets carry it too.
           The three rows are mutually exclusive: the previous-install page is
           skipped on a clean machine, and the data-location page is skipped
           whenever nothing was recorded yet. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog"
               Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog"
               Value="SeamlyPreviousInstallDlg" Order="1"
               Condition="LicenseAccepted = &quot;1&quot; AND ($(var.PreviousInstallFound))" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog"
               Value="SeamlyDataLocationDlg" Order="2"
               Condition="LicenseAccepted = &quot;1&quot; AND NOT ($(var.PreviousInstallFound)) AND SEAMLYDATAROOTRECORDED" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog"
               Value="SeamlyShortcutsDlg" Order="3"
               Condition="LicenseAccepted = &quot;1&quot; AND NOT ($(var.PreviousInstallFound)) AND NOT SEAMLYDATAROOTRECORDED" />

      <!-- Ready page. Back returns to the last question asked, which on a fresh
           install is the shortcuts page. The two maintenance rows are the stock
           ones. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="SeamlyShortcutsDlg" Condition="NOT Installed" Order="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="WelcomeDlg" Condition="Installed AND PATCH" Order="2" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="SeamlyMaintenanceTypeDlg" Condition="Installed AND NOT PATCH" Order="2" />

      <!-- Maintenance, repair and uninstall. The route is the stock one; only
           the middle page is ours, so that it can name the installed version.
           None of the install-time Seamly pages appear,
           because none of their answers apply to a product already installed.
           SeamlyMaintenanceTypeDlg carries its own Back, Repair and Remove
           rows, so only the entry transition is authored here. -->
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog"
               Value="SeamlyMaintenanceTypeDlg" />

      <!-- Configure the stock exit checkbox and launch the application after a
           fresh install. LaunchApplication is defined in smsi.wxs. -->
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Seamly2D now" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

      <!-- Order 1: run before EndDialog closes the wizard. Order 999 leaves room
           for any further row that still needs to run first. -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction"
               Value="LaunchApplication" Order="1"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = &quot;1&quot; AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog"
               Value="Return" Order="999" />
    </UI>

    <!-- SeamlyPrepareDlg's slot: exactly where stock PrepareDlg's own
         fragment would have put it (Before="AppSearch"), just naming our
         dialog instead. Everything after AppSearch - ResumeDlg/WelcomeDlg/
         MaintenanceWelcomeDlg's own baked-in Show rows, asserted at 1296-1298
         by smsi_check_authoring.ps1 - is untouched. -->
    <InstallUISequence>
      <Show Dialog="SeamlyPrepareDlg" Before="AppSearch" />
    </InstallUISequence>
  </Fragment>
</Wix>
