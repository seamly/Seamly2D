<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX source for the Seamly Windows MSI.

  Build with packaging\windows\smsi.ps1 and pass the required -d values.
  The same source builds both x64 and arm64 MSIs.

  This package installs the Seamly suite, keeps user data intact, and upgrades
  older installs in place.
-->

<!-- Fail fast with a clear message when the build script forgot a define. -->
<?ifndef var.ProductVersion ?>
  <?error ProductVersion is not defined - build via packaging\windows\smsi.ps1, which passes -d ProductVersion=YY.M.DDHH ?>
<?endif?>
<?ifndef var.RepoRoot ?>
  <?error RepoRoot is not defined - build via packaging\windows\smsi.ps1, which passes -d RepoRoot=<repo root> ?>
<?endif?>
<?ifndef var.ParentStagingDir ?>
  <?error ParentStagingDir is not defined - build via packaging\windows\smsi.ps1 ?>
<?endif?>
<?ifndef var.ExeStagingDir ?>
  <?error ExeStagingDir is not defined - build via packaging\windows\smsi.ps1 ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Manufacturer must be the legal entity named on the EV code-signing
       certificate (CN=Seamly Systems, Inc.). Windows takes the UAC and
       SmartScreen publisher from the Authenticode signature, not from this
       attribute, so any other value makes Apps &amp; Features disagree with the
       elevation prompt. Source-file copyright headers keep "Seamly Project". -->
  <Package Name="Seamly"
           Manufacturer="Seamly Systems, Inc."
           Version="$(var.ProductVersion)"
           UpgradeCode="cbf4b5f1-c32c-4dbb-b385-3ee4a7b30658"
           Language="1033"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation Description="Seamly $(var.ProductVersion) - apparel CAD for drafting, measurements/sizing, and layout" />

    <!-- Any installed version (any architecture, same UpgradeCode) is removed
         before the new files are installed. AllowDowngrades includes a newer
         installed version, so SeamlyNewerVersionDlg (smsi_ui.wxs) must ask
         first. Two builds of one hour have the same YY.M.DDHH version, so they
         replace each other without the question. -->
    <MajorUpgrade AllowDowngrades="yes" />

    <!-- Detect-only row: sets SEAMLYNEWERINSTALLED when the installed version
         is newer than this package. MajorUpgrade's own row cannot tell a newer
         product from an older one once downgrades are allowed. -->
    <Upgrade Id="cbf4b5f1-c32c-4dbb-b385-3ee4a7b30658">
      <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no"
                      OnlyDetect="yes" Property="SEAMLYNEWERINSTALLED" />
    </Upgrade>

    <!-- Set by SeamlyNewerVersionDlg when the user chooses to uninstall the
         newer version. A silent install must pass SEAMLYDOWNGRADECONFIRMED=1
         on the msiexec command line, or SeamlyBlockDowngrade stops it. -->
    <Property Id="SEAMLYDOWNGRADECONFIRMED" Secure="yes" />
    <CustomAction Id="SeamlyBlockDowngrade"
                  Error="Seamly [SEAMLYINSTALLEDVERSION] is installed. It is newer than this installer, Seamly [ProductVersion]. Uninstall Seamly first to install this version." />
    <!-- After AppSearch, so the message can name the installed version. -->
    <InstallExecuteSequence>
      <Custom Action="SeamlyBlockDowngrade" After="AppSearch"
              Condition="SEAMLYNEWERINSTALLED AND NOT SEAMLYDOWNGRADECONFIRMED AND NOT Installed" />
    </InstallExecuteSequence>

    <!-- Single embedded cab: one self-contained .msi file. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- ================= close running instances ========================= -->
    <!-- Install, upgrade, repair, and uninstall all need each app's files
         unlocked. WixCloseApplications sends WM_CLOSE to a running target
         first, and only force-terminates a process that ignores it.
         PromptToContinue="yes" warns the user before that happens, so a CAD
         app holding unsaved pattern or measurement data is not force-closed
         without notice. ElevatedCloseMessage="yes" is required because
         msiexec itself runs elevated and needs it to reach a non-elevated
         app's windows. -->
    <util:CloseApplication Id="CloseSeamly2D"
                           Target="seamly2d.exe"
                           Description="Seamly2D is running. Setup will close it to continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           PromptToContinue="yes" />
    <util:CloseApplication Id="CloseSeamlyMe"
                           Target="seamlyme.exe"
                           Description="SeamlyMe is running. Setup will close it to continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           PromptToContinue="yes" />
    <util:CloseApplication Id="CloseSeamlyLayout"
                           Target="SeamlyLayout.exe"
                           Description="SeamlyLayout is running. Setup will close it to continue."
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           RebootPrompt="no"
                           PromptToContinue="yes" />

    <!-- Early running-app check for the wizard (SeamlyAppsRunningDlg in
         smsi_ui.wxs). Restart Manager finds running apps only in
         InstallValidate, after a slow scan of every packaged file. These
         actions look up the three process names at once. smsi.ps1 builds the
         DLL from installer_running_apps.cpp. Immediate, UI-only actions: they
         set properties and run as the signed-in user. -->
    <Binary Id="SeamlyRunningAppsDll" SourceFile="$(var.RunningAppsDll)" />
    <CustomAction Id="SeamlyFindRunningApps" BinaryRef="SeamlyRunningAppsDll"
                  DllEntry="SeamlyFindRunningApps" Execute="immediate" Return="ignore" />
    <CustomAction Id="SeamlyCloseRunningApps" BinaryRef="SeamlyRunningAppsDll"
                  DllEntry="SeamlyCloseRunningApps" Execute="immediate" Return="ignore" />

    <!-- Icons for shortcuts and Apps &amp; Features. MSI requires Icon table
         ids used by advertised shortcuts to carry the matching extension, so
         each Id is the icon's own file name — and each Id must be UNIQUE and
         must match what the shortcuts below reference by name. Getting this
         wrong is a link-time failure, not a runtime one: SeamlyLayout's icon
         was declared as a second "seamlyme.ico", which both left SeamlyMe's
         icon ambiguous and left SeamlyLayoutShortcut's Icon="seamlylayout.ico"
         pointing at an identifier that did not exist (error WIX0094). -->
    <Icon Id="seamly2d.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamly2d.ico" />
    <Icon Id="seamlyme.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamlyme.ico" />
    <Icon Id="seamlylayout.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamlylayout.ico" />

    <!-- Image for the SeamlyDataLocationDlg browse button (a Control, not a
         shortcut), so it lives in the Binary table, not the Icon table above. -->
    <Binary Id="folder.ico" SourceFile="$(var.RepoRoot)\packaging\assets\folder.ico" />

    <Property Id="ARPPRODUCTICON" Value="seamly2d.ico" />
    <Property Id="ARPHELPLINK" Value="https://seamly.io" />
    <Property Id="ARPURLINFOABOUT" Value="https://seamly.io" />
    <!-- Apps &amp; features shows ProductVersion, the full YY.M.DDHH project
         version. The ARP comment and HKLM\SOFTWARE\Seamly\Seamly2D
         (DisplayVersion, written by InstallInfoRegistry) carry it too. -->
    <Property Id="ARPCOMMENTS" Value="Seamly $(var.ProductVersion) - apparel CAD pattern drafting (Seamly2D), measurements/sizing (SeamlyMe), and layout (SeamlyLayout)" />

    <!-- The full version of whatever is installed now, for the maintenance
         page and the newer-version page to name. Read from the same HKLM value
         InstallInfoRegistry writes.

         AppSearch runs at 50, long before any dialog, and does NOT overwrite a
         property already set on the command line. Empty when nothing is
         installed, which the page reads as "say nothing about an installed
         version". -->
    <Property Id="SEAMLYINSTALLEDVERSION" Secure="yes">
      <RegistrySearch Id="InstalledDisplayVersionSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DisplayVersion"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Finding the pre-MSI Seamly2D installation and removing it lives in
         smsi_legacy.wxs: the two registry searches, the Start Menu property,
         and the two removal components. This reference is what links that
         fragment - a fragment nothing refers to is dropped without an error,
         and the old product would then be left in place. -->
    <ComponentGroupRef Id="LegacyRemoval" />

    <!-- ================= optional desktop shortcuts ======================= -->
    <!-- Set by the checkbox on SeamlyShortcutsDlg, and overridable on the
         command line for unattended installs:
             msiexec /i Seamly-x64.msi /qn SEAMLYDESKTOPSHORTCUTS=0
         Default 1 (checked), matching the NSIS installer's behaviour of always
         creating shortcuts. Secure="yes" so the value survives the hand-off to
         the elevated server-side sequence that evaluates the component
         conditions. -->
    <Property Id="SEAMLYDESKTOPSHORTCUTS" Value="1" Secure="yes" />

    <!-- ================= user-data root ============== -->
    <!-- Install location is fixed to [ProgramFiles64Folder]SeamlyApps. The
         SetProperty entries in both UI and execute sequences override any prior
         value, including INSTALLFOLDER passed on the command line. -->
    <SetProperty Id="INSTALLFOLDER"
                 Action="SetINSTALLFOLDER"
                 Value="[ProgramFiles64Folder]SeamlyApps"
                 Sequence="ui"
                 Before="CostFinalize" />
    <SetProperty Id="INSTALLFOLDER"
                 Action="SetINSTALLFOLDERExecute"
                 Value="[ProgramFiles64Folder]SeamlyApps"
                 Sequence="execute"
                 Before="CostFinalize" />

    <!-- The data root is fixed, not chosen. A fresh install always uses
         [%USERPROFILE]\seamly2d. An update or repair instead reuses whatever
         directory an earlier install already recorded here, so existing data
         is never relocated - see B1-B3/C1-C2 in TODO_INSTALLER.md.

         Two properties, not one: SEAMLYDATAROOTRECORDED holds only what the
         registry search actually found - nothing else ever writes it - so
         smsi_ui.wxs can use it as the "an earlier install exists" signal.
         SEAMLYDATAROOT is the value everything else uses: the recorded root
         when there is one, otherwise the fresh-install default. -->
    <Property Id="SEAMLYDATAROOTRECORDED" Secure="yes">
      <RegistrySearch Id="RecordedDataRootSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DataRoot"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="SEAMLYDATAROOT" Secure="yes" />
    <SetProperty Id="SEAMLYDATAROOT"
                 Action="SetSEAMLYDATAROOTRecorded"
                 Value="[SEAMLYDATAROOTRECORDED]"
                 Before="CostFinalize"
                 Sequence="ui"
                 Condition="SEAMLYDATAROOTRECORDED" />
    <SetProperty Id="SEAMLYDATAROOT"
                 Action="SetSEAMLYDATAROOTRecordedExecute"
                 Value="[SEAMLYDATAROOTRECORDED]"
                 Before="CostFinalize"
                 Sequence="execute"
                 Condition="SEAMLYDATAROOTRECORDED" />
    <!-- Fresh install only: nothing recorded, and this is not a repair or
         maintenance run. The NOT Installed guard is what keeps a repair from
         ever overriding the recorded root. Computed in both sequences so an
         unattended /qn install, which runs no UI sequence, still gets a value. -->
    <SetProperty Id="SEAMLYDATAROOT"
                 Action="SetSEAMLYDATAROOTDefault"
                 Value="[%USERPROFILE]\seamly2d"
                 Before="CostFinalize"
                 Sequence="ui"
                 Condition="NOT SEAMLYDATAROOTRECORDED AND NOT Installed" />
    <SetProperty Id="SEAMLYDATAROOT"
                 Action="SetSEAMLYDATAROOTDefaultExecute"
                 Value="[%USERPROFILE]\seamly2d"
                 Before="CostFinalize"
                 Sequence="execute"
                 Condition="NOT SEAMLYDATAROOTRECORDED AND NOT Installed" />

    <!-- The wizard dialog set and every transition between its pages lives in
         smsi_ui.wxs. This reference is what links it: a WiX fragment nothing
         refers to is dropped without an error, leaving an MSI that builds and
         shows the wrong pages. Do not remove it. -->
    <UIRef Id="SeamlyUI" />

    <!-- ================= ensure the user-data tree ======================= -->
    <!-- Creates the standard data subfolders and seeds the per-user settings
         ini files under SEAMLYDATAROOT, so no app needs a manual Preferences >
         Paths visit to get working path settings. Add-only and non-fatal: the
         apps fill missing defaults at runtime. Runs on every install that has
         a resolved data root - fresh, update, AND repair - so a repair can
         fill in anything missing without disturbing existing files (C2).
         Deferred and impersonated so it runs as the logged-on user, which
         matters for OneDrive and mapped drives.

         Keep the trailing space before the closing quote of each argument:
         PowerShell trims each one, and without the space a trailing backslash
         in a property value could otherwise escape the quote. -->
    <SetProperty Id="SeamlyEnsureUserData"
                 Action="SetSeamlyEnsureUserData"
                 Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]smsi_ensure_user_data.ps1&quot; -DataRoot &quot;[SEAMLYDATAROOT] &quot; -InstallFolder &quot;[INSTALLFOLDER] &quot;"
                 Before="SeamlyEnsureUserData"
                 Sequence="execute"
                 Condition="SEAMLYDATAROOT" />

    <CustomAction Id="SeamlyEnsureUserData"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- After InstallFiles, so the helper script exists on disk; after
         WriteRegistryValues so the recorded DataRoot is already correct. -->
    <InstallExecuteSequence>
      <Custom Action="SeamlyEnsureUserData"
              After="WriteRegistryValues"
              Condition="SEAMLYDATAROOT" />
    </InstallExecuteSequence>

    <!-- Launch Seamly2D from the Finish page.
         Uses WixShellExec to run as the signed-in user, not elevated.
         [#Seamly2DExe] = seamly2d.exe installed path. -->
    <Property Id="WixShellExecTarget" Value="[#Seamly2DExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- The directory tree, the three executables, their Start Menu shortcuts
         and their file associations are in smsi_files.wxs. The optional
         desktop shortcuts are in smsi_shortcuts.wxs. The install-info
         registry values and the per-user settings removal are in
         smsi_registry.wxs. These references are what link those fragments -
         a fragment nothing refers to is dropped without an error. -->
    <ComponentGroupRef Id="SuiteExecutables" />
    <ComponentGroupRef Id="UserDataRootFolder" />
    <ComponentGroupRef Id="InstallInfo" />
    <ComponentGroupRef Id="OptionalDesktopShortcuts" />
    <ComponentGroupRef Id="PerUserSettingsRemoval" />

  </Package>
</Wix>
