<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX source for the Seamly Windows MSI.

  Build with packaging\windows\smsi.ps1 and pass the required -d values.
  The same source builds both x64 and arm64 MSIs.

  This package installs the Seamly suite, keeps user data intact, and upgrades
  older installs in place.
-->

<!-- Fail fast with a clear message when the build script forgot a define. -->
<?ifndef var.ProductVersion ?>
  <?error ProductVersion is not defined - build via packaging\windows\smsi.ps1, which passes -d ProductVersion=x.y.z ?>
<?endif?>
<?ifndef var.DisplayVersion ?>
  <?error DisplayVersion is not defined - build via packaging\windows\smsi.ps1, which passes -d DisplayVersion=YY.M.D.MMMM ?>
<?endif?>
<?ifndef var.RepoRoot ?>
  <?error RepoRoot is not defined - build via packaging\windows\smsi.ps1, which passes -d RepoRoot=<repo root> ?>
<?endif?>
<?ifndef var.ParentStagingDir ?>
  <?error ParentStagingDir is not defined - build via packaging\windows\smsi.ps1 ?>
<?endif?>
<?ifndef var.ExeStagingDir ?>
  <?error ExeStagingDir is not defined - build via packaging\windows\smsi.ps1 ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- Manufacturer must be the legal entity named on the EV code-signing
       certificate (CN=Seamly Systems, Inc.). Windows takes the UAC and
       SmartScreen publisher from the Authenticode signature, not from this
       attribute, so any other value makes Apps &amp; Features disagree with the
       elevation prompt. Source-file copyright headers keep "Seamly Project". -->
  <Package Name="Seamly"
           Manufacturer="Seamly Systems, Inc."
           Version="$(var.ProductVersion)"
           UpgradeCode="cbf4b5f1-c32c-4dbb-b385-3ee4a7b30658"
           Language="1033"
           Compressed="yes"
           Scope="perMachine">

    <SummaryInformation Description="Seamly $(var.DisplayVersion) - apparel CAD for drafting, measurements/sizing, and layout" />

    <!-- Newer versions upgrade in place: the old product (any architecture,
         same UpgradeCode) is removed before the new files are installed.
         AllowSameVersionUpgrades keeps rolling same-minute rebuilds working. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first to install this older version." />

    <!-- Single embedded cab: one self-contained .msi file. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icons for shortcuts and Apps &amp; Features. MSI requires Icon table
         ids used by advertised shortcuts to carry the matching extension, so
         each Id is the icon's own file name — and each Id must be UNIQUE and
         must match what the shortcuts below reference by name. Getting this
         wrong is a link-time failure, not a runtime one: SeamlyLayout's icon
         was declared as a second "seamlyme.ico", which both left SeamlyMe's
         icon ambiguous and left SeamlyLayoutShortcut's Icon="seamlylayout.ico"
         pointing at an identifier that did not exist (error WIX0094). -->
    <Icon Id="seamly2d.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamly2d.ico" />
    <Icon Id="seamlyme.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamlyme.ico" />
    <Icon Id="seamlylayout.ico" SourceFile="$(var.RepoRoot)\packaging\assets\seamlylayout.ico" />

    <Property Id="ARPPRODUCTICON" Value="seamly2d.ico" />
    <Property Id="ARPHELPLINK" Value="https://seamly.io" />
    <Property Id="ARPURLINFOABOUT" Value="https://seamly.io" />
    <!-- Apps &amp; features shows the numeric MSI ProductVersion (26.y.z) as its
         DisplayVersion, and that cannot be overridden: the RegisterProduct
         standard action writes that value into the Uninstall key *after*
         WriteRegistryValues, so any component-authored override is overwritten.
         The full YY.M.D.MMMM project version therefore reaches the user two
         other ways — the ARP comment here, and HKLM\SOFTWARE\Seamly\Seamly2D
         (DisplayVersion) written by InstallInfoRegistry below. -->
    <Property Id="ARPCOMMENTS" Value="Seamly $(var.DisplayVersion) - apparel CAD pattern drafting (Seamly2D), measurements/sizing (SeamlyMe), and layout (SeamlyLayout)" />

    <!-- The full version of whatever is installed now, for the maintenance
         page to name. Read from the same HKLM value
         InstallInfoRegistry writes, because Apps and features stores only the
         numeric MSI ProductVersion and that is not the version a user sees in
         the apps.

         AppSearch runs at 50, long before any dialog, and does NOT overwrite a
         property already set on the command line. Empty when nothing is
         installed, which the page reads as "say nothing about an installed
         version". -->
    <Property Id="SEAMLYINSTALLEDVERSION" Secure="yes">
      <RegistrySearch Id="InstalledDisplayVersionSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DisplayVersion"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Finding the pre-MSI Seamly2D installation and removing it lives in
         smsi_legacy.wxs: the two registry searches, the Start Menu property,
         and the two removal components. This reference is what links that
         fragment - a fragment nothing refers to is dropped without an error,
         and the old product would then be left in place. -->
    <ComponentGroupRef Id="LegacyRemoval" />

    <!-- ================= optional desktop shortcuts ======================= -->
    <!-- Set by the checkbox on SeamlyShortcutsDlg, and overridable on the
         command line for unattended installs:
             msiexec /i Seamly-x64.msi /qn SEAMLYDESKTOPSHORTCUTS=0
         Default 1 (checked), matching the NSIS installer's behaviour of always
         creating shortcuts. Secure="yes" so the value survives the hand-off to
         the elevated server-side sequence that evaluates the component
         conditions. -->
    <Property Id="SEAMLYDESKTOPSHORTCUTS" Value="1" Secure="yes" />

    <!-- ================= user-data root ============== -->
    <!-- User data folder. SEAMLYDATAPARENT is the chosen parent; the final
         data root is SEAMLYDATAROOT (parent + \SeamlyData). Both are
         Directory ids so the wizard, BrowseDlg, and command-line installs all
         work consistently. -->
    <!-- Install location is fixed to [ProgramFiles64Folder]SeamlyApps. The
         SetProperty entries in both UI and execute sequences override any prior
         value, including INSTALLFOLDER passed on the command line. -->
    <SetProperty Id="INSTALLFOLDER"
                 Action="SetINSTALLFOLDER"
                 Value="[ProgramFiles64Folder]SeamlyApps"
                 Sequence="ui"
                 Before="CostFinalize" />
    <SetProperty Id="INSTALLFOLDER"
                 Action="SetINSTALLFOLDERExecute"
                 Value="[ProgramFiles64Folder]SeamlyApps"
                 Sequence="execute"
                 Before="CostFinalize" />
    <Property Id="SEAMLYDATAROOT" Secure="yes" />
    <Property Id="SEAMLYDATAPARENT" Secure="yes">
      <RegistrySearch Id="RecordedDataParentSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DataParent"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <!-- The default parent is the user's Documents folder, so the data root
         sits beside other app data and matches the app defaults. Use
         PersonalFolder first because it follows redirected Documents folders,
         such as OneDrive. If it is empty, fall back to %USERPROFILE%\Documents.
         The trailing backslash matters: Windows appends the child folder to the
         parent verbatim, so a missing slash would create a wrong path. -->
    <SetProperty Id="SEAMLYDATAPARENT"
                 Action="SetSEAMLYDATAPARENT"
                 Value="[PersonalFolder]"
                 Before="CostFinalize"
                 Sequence="ui"
                 Condition="NOT SEAMLYDATAPARENT AND PersonalFolder AND NOT Installed" />
    <SetProperty Id="SEAMLYDATAPARENT"
                 Action="SetSEAMLYDATAPARENTFallback"
                 Value="[%USERPROFILE]\Documents\"
                 After="SetSEAMLYDATAPARENT"
                 Sequence="ui"
                 Condition="NOT SEAMLYDATAPARENT AND NOT Installed" />

    <!-- Same two defaults, computed again in the execute sequence, for a
         `/qn` install that ran no UI sequence at all. See the accepted
         SYSTEM-profile tradeoff in the comment above SEAMLYDATAPARENT.
         Mirrors the UI pair exactly: PersonalFolder first, %USERPROFILE%
         second, both skipped on a maintenance run so a repair never
         recomputes a customised root. -->
    <SetProperty Id="SEAMLYDATAPARENT"
                 Action="SetSEAMLYDATAPARENTExecute"
                 Value="[PersonalFolder]"
                 Before="CostFinalize"
                 Sequence="execute"
                 Condition="NOT SEAMLYDATAPARENT AND PersonalFolder AND NOT Installed" />
    <SetProperty Id="SEAMLYDATAPARENT"
                 Action="SetSEAMLYDATAPARENTExecuteFallback"
                 Value="[%USERPROFILE]\Documents\"
                 After="SetSEAMLYDATAPARENTExecute"
                 Sequence="execute"
                 Condition="NOT SEAMLYDATAPARENT AND NOT Installed" />

    <!-- ============ the value the apps actually read ===== -->
    <!-- Record the chosen data path, not the raw directory ID. CostFinalize
         resolves directory IDs to a machine path like C:\SeamlyData or C:\,
         which is not what the app should persist. This value is what the app
         reads from HKLM\SOFTWARE\Seamly\Seamly2D and is only set when the
         user or this install actually chose a location.

         During repair or maintenance, keep the registry value already present.
         During a fresh install or silent run, prefer the resolved path chosen
         this run. The UI and execute defaults must guard with AND NOT
         Installed so a repair does not silently reset a custom data root. -->
    <Property Id="SEAMLYDATAROOTRECORDED" Secure="yes">
      <RegistrySearch Id="RecordedDataRootSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DataRoot"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="SEAMLYDATAPARENTRECORDED" Secure="yes">
      <RegistrySearch Id="RecordedDataParentRecordedSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DataParent"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="SEAMLYPREVIOUSDATAROOT" Secure="yes">
      <RegistrySearch Id="PreviousDataRootSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Seamly\Seamly2D"
                      Name="DataRoot"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <SetProperty Id="SEAMLYDATACHOSEN"
                 Value="1"
                 After="SetSEAMLYDATAPARENTExecuteFallback"
                 Sequence="execute"
                 Condition="SEAMLYDATAPARENT OR SEAMLYDATAROOT" />
    <SetProperty Id="SEAMLYDATAROOTRECORDED"
                 Value="[SEAMLYDATAROOT]"
                 After="CostFinalize"
                 Sequence="execute"
                 Condition="SEAMLYDATACHOSEN" />
    <SetProperty Id="SEAMLYDATAPARENTRECORDED"
                 Value="[SEAMLYDATAPARENT]"
                 After="CostFinalize"
                 Sequence="execute"
                 Condition="SEAMLYDATACHOSEN" />
    <!-- Set by SeamlyDataMigrateDlg's confirmation. 0 = record the folder but
         copy nothing. The copy is opt-in: it is the user's data, and an
         unattended install must not start moving files nobody asked about. -->
    <Property Id="SEAMLYCOPYUSERDATA" Value="0" Secure="yes" />

    <!-- The wizard dialog set and every transition between its pages lives in
         smsi_ui.wxs. This reference is what links it: a WiX fragment nothing
         refers to is dropped without an error, leaving an MSI that builds and
         shows the wrong pages. Do not remove it. -->
    <UIRef Id="SeamlyUI" />

    <!-- ================= migrate existing user data ====================== -->
    <!-- Copy existing user data into the selected data root.
         The helper script archives the old tree, restores it under the new
         parent, and only updates the stored data paths after validation.

         This runs as the logged-on user so OneDrive and mapped drives work, and
         it is best-effort: it never overwrites data and a failure does not roll
         back the install.

         Deferred actions cannot read MSI properties directly, so the command is
         passed through CustomActionData before it runs. -->
    <!-- Keep the trailing space before each closing quote. PowerShell trims
         each argument; without the space, adjacent quoted paths can merge. -->
    <SetProperty Id="SeamlyCopyUserData"
                 Action="SetSeamlyOldDataMigration"
                 Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]smsi_migrate_user_data.ps1&quot; -Mode Old -Destination &quot;[SEAMLYDATAROOT] &quot; -InstallFolder &quot;[INSTALLFOLDER] &quot;"
                 Before="SeamlyCopyUserData"
                 Sequence="execute"
                 Condition="SEAMLYCOPYUSERDATA = &quot;1&quot; AND SEAMLYDATAROOT AND SEAMLYOLDS2DEXE AND SEAMLYOLDMEEXE AND NOT SEAMLYOLDLAYOUTEXE AND NOT Installed" />

    <SetProperty Id="SeamlyCopyUserData"
                 Action="SetSeamlyNewDataMigration"
                 Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]smsi_migrate_user_data.ps1&quot; -Mode New -Destination &quot;[SEAMLYDATAROOT] &quot; -PreviousDataRoot &quot;[SEAMLYPREVIOUSDATAROOT] &quot; -InstallFolder &quot;[INSTALLFOLDER] &quot;"
                 Before="SeamlyCopyUserData"
                 Sequence="execute"
                 Condition="SEAMLYCOPYUSERDATA = &quot;1&quot; AND SEAMLYDATAROOT AND SEAMLYNEWLAYOUTEXE AND NOT Installed" />

    <CustomAction Id="SeamlyCopyUserData"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- After InstallFiles, so the helper script exists on disk; after
         WriteRegistryValues so the recorded DataRoot is already correct even if
         the copy is skipped or fails. -->
    <InstallExecuteSequence>
      <Custom Action="SeamlyCopyUserData"
              After="WriteRegistryValues"
              Condition="SEAMLYCOPYUSERDATA = &quot;1&quot; AND SEAMLYDATAROOT AND ((SEAMLYOLDS2DEXE AND SEAMLYOLDMEEXE AND NOT SEAMLYOLDLAYOUTEXE) OR SEAMLYNEWLAYOUTEXE) AND NOT Installed" />
    </InstallExecuteSequence>

    <!-- Seed the per-user settings directories and INI files so a fresh install
         works without a manual Preferences > Paths visit. Deferred and
         impersonated like SeamlyCopyUserData; non-fatal because the apps fill
         missing defaults at runtime. The script is add-only, so it preserves
         migrated values and only runs when a data root was recorded. -->
    <SetProperty Id="SeamlySeedUserSettings"
                 Action="SetSeamlySeedUserSettings"
                 Value="&quot;powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]smsi_seed_user_settings.ps1&quot; -DataRoot &quot;[SEAMLYDATAROOTRECORDED] &quot; -InstallFolder &quot;[INSTALLFOLDER] &quot;"
                 Before="SeamlySeedUserSettings"
                 Sequence="execute"
                 Condition="SEAMLYDATAROOTRECORDED AND NOT Installed" />

    <CustomAction Id="SeamlySeedUserSettings"
                  DllEntry="WixQuietExec64"
                  BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="SeamlySeedUserSettings"
              After="SeamlyCopyUserData"
              Condition="SEAMLYDATAROOTRECORDED AND NOT Installed" />
    </InstallExecuteSequence>

    <!-- Launch Seamly2D from the Finish page.
         Uses WixShellExec to run as the signed-in user, not elevated.
         [#Seamly2DExe] = seamly2d.exe installed path. -->
    <Property Id="WixShellExecTarget" Value="[#Seamly2DExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />

    <!-- The directory tree, the three executables, their Start Menu shortcuts
         and their file associations are in smsi_files.wxs. The optional
         desktop shortcuts are in smsi_shortcuts.wxs. The install-info
         registry values and the per-user settings removal are in
         smsi_registry.wxs. These references are what link those fragments -
         a fragment nothing refers to is dropped without an error. -->
    <ComponentGroupRef Id="SuiteExecutables" />
    <ComponentGroupRef Id="UserDataRootFolder" />
    <ComponentGroupRef Id="InstallInfo" />
    <ComponentGroupRef Id="OptionalDesktopShortcuts" />
    <ComponentGroupRef Id="PerUserSettingsRemoval" />

  </Package>
</Wix>
