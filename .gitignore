*-build-*

# Local build and packaging output, ignored by NAME rather than by relying on the
# "*-build-*" pattern above. That pattern matched scripts/seamly-build-msi only
# incidentally, so renaming the directory silently made hundreds of megabytes of
# build output committable - which is exactly what happened when it was renamed
# to the name below.
# smsi.ps1 creates packaging/windows/seamly-msi/<arch>; nothing in that tree
# is tracked.
packaging/windows/seamly-msi/
build/

# Qt translation file
*.qm

# QtCreator
*.autosave

# QtCtreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QT creator files
.qtc_clangd/
.vscode/
.qmake.stash

# Xcode project
*.xcodeproj

# OSX specific
.DS_Store
.AppleDouble
.LSOverride


# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Understand IDE file
*.udb

# target_wrapper.sh / .bat files are generated/updated automatically.
# qmake writes one per test target next to its .pro when CONFIG += testcase
# supplies the `check` rule: .sh on Unix, .bat on Windows. The .bat appears
# only when the Qt suites are built on Windows, which
# packaging/windows/local_build_msi.ps1 now does.
target_wrapper.sh
target_wrapper.bat
*.bak

# Claude Code personal overrides — NOT tracked. The shared .claude/settings.json
# is committed; this file is per-machine and the harness rewrites it on every
# permission grant, accumulating absolute paths and session ids that have no
# business in a repository headed for the upstream pull request.
# (Was "!.claude/settings.local.json" — force-tracked — until 2026-07-27.)
.claude/settings.local.json

# Ignore doxygen directory
docs/

# Ignore build outputs and local state
src/app/seamlylayout/target/
src/app/seamlylayout/logs/
src/app/seamlylayout/qt_frontend/build/
CMakeFiles/
CMakeCache.txt
node_modules/

# Qt test logs written to SEAMLY_TEST_LOG_DIR
testlogs*/

# TRACK THESE FILES =======
# Git uses the last rule that matches a path. Keep this block at the end of the file.

# track third-party license notices - shipped in every installer
!packaging/licenses/*.txt

# track xerces lib
!xerces-c_3D.lib
!xerces-c_3_2D.dll

# track build configuration files
!CMakeLists.txt
!CMakePresets.json

# track icons and other resource images
!icon/
!src/app/seamly2d/share/resources/toolicon/
!src/app/seamly2d/share/resources/toolicon/**
!**/share/resources/**/*.png
!src/app/seamlylayout/qt_frontend/assets/**/*.png
!packaging/assets/*.png

