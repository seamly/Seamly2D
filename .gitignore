# Ignore temporary files
*~

# Ignore Mercurial .orig files
*.orig

# Ignore Git merge-related files
*.rej

# Seamly2D lock files
*.locked

# test key files
*seamly-signing-key.json

# Previous backup file formats
*(v*).val*
*(v*).vit*
*(v*).vst*

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

# Lock files used by the Emacs editor.
# Notice that the "#" character is quoted with a backslash.
# This prevents it from being interpreted as starting a comment.
.\#*

# Temporary files used by the vim editor.
.*.swp

# A hidden files created by the Mac OS X Finder.
.DS_Store
._.DS_Store

# Ignore these directories.
html/
latex/
bin/
moc/
obj/
uic/
rcc/
man/
build/
.vscode/*

# Python bytecode cache
__pycache__/
*.pyc

# Ignore Coverity Scan Build Tool
cov-int/

# Compiled Object files
*.slo
*.lo
*.o
*.obj
*.ko
*.elf

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib
*.lo

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/

# Qt-es
/.qmake.cache
/.qmake.stash

# track qtCreator files for testing
!*.pro.user
!*.pro.user.*
!*.qbs.user

# Qt compiled files
*.moc
moc_*.cpp
qrc_*.cpp
ui_*.h
Makefile*
*-build-*

# Qt translation file
*.qm

# QtCreator
*.autosave

# QtCtreator Qml
*.qmlproject.user
*.qmlproject.user.*

# QT creator files
.qtc_clangd/
.vscode/
.qmake.stash

# Xcode project
*.xcodeproj

# OSX specific
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Understand IDE file
*.udb

# target_wrapper.sh files are generated/updated automatically
target_wrapper.sh
*.bak

# Allow xerces lib
!xerces-c_3D.lib
!xerces-c_3_2D.dll

# Claude Code personal overrides — NOT tracked. The shared .claude/settings.json
# is committed; this file is per-machine and the harness rewrites it on every
# permission grant, accumulating absolute paths and session ids that have no
# business in a repository headed for the upstream pull request.
# (Was "!.claude/settings.local.json" — force-tracked — until 2026-07-27.)
.claude/settings.local.json

# track claude Session handover file
!SESSION_HANDOVER.md

# documents
docs/

# seamlylayout daughter app (absorbed from the former nested seamlyLayout repo).
# Its docs tree stays tracked despite the global docs/ rule above.
!src/app/seamlylayout/docs/
# track seamlylayout .claude & .vs files for testing
!src/app/seamlylayout/.claude/
!src/app/seamlylayout/.vs/
# track seamlylayout input * output files for testing
!src/app/seamlylayout/input/
src/app/seamlylayout/output/
# Ignore build outputs and local state (also covered by src/app/seamlylayout/.gitignore,
src/app/seamlylayout/target/
src/app/seamlylayout/logs/
src/app/seamlylayout/qt_frontend/build/
# track seamlylayout local build files for testing
!src/app/seamlylayout/qt_frontend/CMakeFiles/
!src/app/seamlylayout/qt_frontend/CMakeCache.txt
!src/app/seamlylayout/qt_frontend/.cmake/
!src/app/seamlylayout/qt_frontend/.qt/
!src/app/seamlylayout/qt_frontend/*.user
